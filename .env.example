# =============================================================================
# Root .env — used by the backend (backend/src/index.js loads ../../.env)
# Copy this file to .env and fill in real values. Never commit .env itself.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# Use 127.0.0.1 (not "localhost") for local dev on Node v26+ to force IPv4.
# In containerized/prod, use the service name (e.g. postgres) or managed host.
DATABASE_URL=postgresql://app_user:localpassword@127.0.0.1:5432/patient_records

# Set to "true" when connecting to any managed Postgres (Neon, RDS, Supabase).
# Leave unset or "false" for local Docker Postgres.
DATABASE_SSL=false

# Optional. Defaults to 10 if unset.
DB_POOL_MAX=10

# ---- Auth0 ------------------------------------------------------------------
# From the Auth0 dashboard: Applications -> your app -> Settings.
AUTH0_DOMAIN=your-tenant.au.auth0.com
AUTH0_AUDIENCE=https://api.patientrecords.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me

# ---- OpenFGA ----------------------------------------------------------------
# API URL: http://localhost:8080 locally, or your managed FGA endpoint.
FGA_API_URL=http://localhost:8080

# Populated by running: npm run fga:bootstrap  (or set manually if already known).
# Store ID persists across `docker compose down` (only wiped on `down -v`).
FGA_STORE_ID=
FGA_MODEL_ID=

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3001
